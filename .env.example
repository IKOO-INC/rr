# ============================================================
# Salin ke .env (lokal) dan isi Environment Variables di Vercel
# ============================================================

# --- WhatsApp Business API (resmi, direkomendasikan) ---
# Dapatkan dari Meta for Developers / BSP (Twilio, MessageBird, 360dialog)
WA_BUSINESS_PHONE_NUMBER_ID=
WA_BUSINESS_ACCESS_TOKEN=
WA_WEBHOOK_VERIFY_TOKEN=rr_wa_verify_2026

# --- Vercel KV (opsional, untuk metadata sesi di sisi server) ---
# Aktifkan di Vercel: Storage → Create KV → tambahkan integrasi ke project ini
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# --- Catatan penting ---
# whatsapp-web.js / Baileys (klien WhatsApp non-resmi) TIDAK berjalan
# di Vercel Serverless Functions, karena butuh Node.js proses yang selalu hidup
# dan koneksi WebSocket permanen. Gunakan Railway / Render / VPS untuk itu,
# atau pakai WhatsApp Multi-Device bawaan di web.whatsapp.com tanpa deploy.
